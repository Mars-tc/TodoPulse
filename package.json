{
  "name": "TodoPulse",
  "version": "1.4.1",
  "description": "统信UOS桌面Todo待办应用，配套Chromium浏览器扩展；支持分类、搜索排序、重复与子任务、到期提醒、统计面板、回收站与导入导出",
  "main": "src-main/main.js",
  "author": "Sapiens AI",
  "homepage": "https://github.com/sapiens-ai/TodoPulse",
  "scripts": {
    "dev": "vite --config src-renderer/vite.config.js",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build --config src-renderer/vite.config.js",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --dir",
    "dist": "vite build --config src-renderer/vite.config.js && electron-builder --linux deb",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "test": "node tests/repeat_rule.test.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "chrono-node": "^2.7.0",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.1.0",
    "vue": "^3.4.21",
    "wait-on": "^7.2.0",
    "electron-rebuild": "^3.2.9"
  }
}
